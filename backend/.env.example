# OpenRouter API Key for Zero-Hallucination LLM extraction (Claude 3.5 Sonnet / GPT-4o / Gemini 2.0 Flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI API Key for SOTA Mistral OCR (mistral-ocr-latest)
MISTRAL_API_KEY=your_mistral_api_key_here

# Default AI Model (anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-2.0-flash-001, etc.)
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet

# Database URL (Default SQLite for local dev, or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./loanlens.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loanlens
